# Kopiere diese Datei zu .env und trage echte Werte ein.
# .env selbst NICHT committen (steht in .gitignore).

# Fernet-Key zur Verschlüsselung der Session-Daten (Chat, Dokumente, PDF-Formulardaten).
# Erzeugen mit: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WICHTIG: darf sich nach dem ersten Speichern von Sitzungen nicht mehr ändern.
ENCRYPTION_KEY=

SESSION_LIFETIME_DAYS=28
SESSION_EXTEND_DAYS=3
CLEANUP_INTERVAL_SECONDS=3600

DATABASE_URL=sqlite:///./pflege_sicher.db
FRONTEND_ORIGIN=http://localhost:5173
API_URL=http://127.0.0.1:8000

DATA_DIR=./daten
QDRANT_DIR=./qdrant_db

EMBEDDING_MODEL=bge-m3
LLM_MODEL=mistral-nemo

# Vektordatenbank als Dienst (docker compose up -d).
# Zeile entfernen oder leer lassen, um den eingebetteten Betrieb zu nutzen
# (dann kann jeweils nur ein Prozess zugreifen).
QDRANT_URL=http://127.0.0.1:6333
